# All variables are optional and read at BUILD time (they are baked into the static HTML).

# Repository URL used for "Edit this page" links and the GitHub icon. Links are hidden when unset.
PUBLIC_REPO_URL=https://github.com/acme/handbook

# Branch the edit links point at (default: main).
PUBLIC_REPO_BRANCH=main

# Public URL of the deployed site. Sets Astro's `site`, enabling canonical URLs and the sitemap.
PUBLIC_SITE_URL=https://handbook.example.com
